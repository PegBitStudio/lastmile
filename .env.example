# Server only. Never expose this to the browser.
ASSEMBLYAI_API_KEY=

# The agent id from the AssemblyAI dashboard. Safe in the browser.
NEXT_PUBLIC_AGENT_ID=

# Postgres. Server only. Any provider: Neon and Supabase both work.
# Use the POOLED connection string — a serverless function that opens a direct
# connection per request runs a managed Postgres out of connections fast.
# Leave it unset and the app still runs; records simply live in the browser tab.
DATABASE_URL=
