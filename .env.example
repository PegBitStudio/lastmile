# Server only. Never expose this to the browser.
ASSEMBLYAI_API_KEY=

# Agent ids. Safe in the browser.
# One agent per region, because keyterms live on the agent, not the session.
#   REGION=ng-lagos  npm run agent:create   -> NEXT_PUBLIC_AGENT_ID_NG_LAGOS
#   REGION=pk-lahore npm run agent:create   -> NEXT_PUBLIC_AGENT_ID_PK_LAHORE
# A region left blank falls back to NEXT_PUBLIC_AGENT_ID, and the screen says so.
NEXT_PUBLIC_AGENT_ID=
NEXT_PUBLIC_AGENT_ID_NG_LAGOS=
NEXT_PUBLIC_AGENT_ID_PK_LAHORE=

# Postgres. Server only. Any provider: Neon and Supabase both work.
# Use the POOLED connection string — a serverless function that opens a direct
# connection per request runs a managed Postgres out of connections fast.
# Leave it unset and the app still runs; records simply live in the browser tab.
DATABASE_URL=
